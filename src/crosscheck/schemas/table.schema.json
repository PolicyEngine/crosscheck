{
  "$defs": {
    "Alias": {
      "additionalProperties": false,
      "description": "One tool's own name for a quantity.",
      "properties": {
        "name": {
          "description": "The tool's name for the quantity.",
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "tool": {
          "description": "The tool that uses the name.",
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "name"
      ],
      "title": "Alias",
      "type": "object"
    },
    "Binding": {
      "additionalProperties": false,
      "description": "How one case became one run's inputs. Key: (case_set, case_id, policy_world, run).\n\nA binding never borrows an input from its own run.",
      "properties": {
        "case_id": {
          "description": "The case id.",
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "case_set": {
          "description": "The case set.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+@=-]*$",
          "type": "string"
        },
        "facts_not_taken": {
          "default": [],
          "description": "Stated facts the model could not take.",
          "items": {
            "$ref": "#/$defs/ScopedNote"
          },
          "type": "array"
        },
        "input_map_author": {
          "default": "",
          "description": "Who wrote the input map.",
          "type": "string"
        },
        "input_map_author_kind": {
          "default": "unknown",
          "description": "What kind of author wrote the input map.",
          "enum": [
            "person",
            "ai_model",
            "rules_model",
            "harness",
            "unknown"
          ],
          "type": "string"
        },
        "input_maps": {
          "default": [],
          "description": "Ids (with version) of every map layer that turned the case's facts into the model's inputs.",
          "items": {
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
            "type": "string"
          },
          "type": "array"
        },
        "inputs_from_runs": {
          "default": [],
          "description": "Inputs that other runs computed.",
          "items": {
            "$ref": "#/$defs/BorrowedInput"
          },
          "type": "array"
        },
        "note": {
          "default": "",
          "description": "Anything else about the binding.",
          "type": "string"
        },
        "policy_world": {
          "description": "The PolicyWorld id.",
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "rendered_input": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The model's own input for this case as text (JSON), when the source keeps it."
        },
        "run": {
          "description": "The Run id.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+@=-]*$",
          "type": "string"
        },
        "transform": {
          "default": [],
          "description": "What the map did to this case.",
          "items": {
            "$ref": "#/$defs/ScopedNote"
          },
          "type": "array"
        }
      },
      "required": [
        "case_set",
        "case_id",
        "policy_world",
        "run"
      ],
      "title": "Binding",
      "type": "object"
    },
    "BorrowedInput": {
      "additionalProperties": false,
      "description": "An input that another run computed and this binding took.",
      "properties": {
        "bears_on_answer": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "False when the borrowed input does not affect this case's answer; null when not stated."
        },
        "quantities": {
          "default": [],
          "description": "Quantity ids the input bears on; empty means every quantity.",
          "items": {
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
            "type": "string"
          },
          "type": "array"
        },
        "run": {
          "description": "The Run id that computed the input.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+@=-]*$",
          "type": "string"
        },
        "what": {
          "description": "Which input, in words.",
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "run",
        "what"
      ],
      "title": "BorrowedInput",
      "type": "object"
    },
    "Case": {
      "additionalProperties": false,
      "description": "A case in a case set under one policy world. Key: (case_set, case_id, policy_world).\n\nThe (concept, entity) pairs of `facts` are unique within the case.",
      "properties": {
        "case_id": {
          "description": "The case's id within its case set.",
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "case_set": {
          "description": "The case set; it names a file.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+@=-]*$",
          "type": "string"
        },
        "facts": {
          "default": [],
          "description": "The case's stated facts.",
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "type": "array"
        },
        "facts_complete": {
          "default": false,
          "description": "True only when every fact a model needs is stated in facts.",
          "type": "boolean"
        },
        "policy_world": {
          "description": "The PolicyWorld id the case is answered under.",
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "source": {
          "default": "",
          "description": "Where the case came from.",
          "type": "string"
        }
      },
      "required": [
        "case_set",
        "case_id",
        "policy_world"
      ],
      "title": "Case",
      "type": "object"
    },
    "EngineLink": {
      "additionalProperties": false,
      "description": "An engine behind a run's values beyond the model's own, with the role it played.",
      "properties": {
        "engine": {
          "description": "The engine family.",
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "role": {
          "description": "How the engine stands behind the values.",
          "enum": [
            "host",
            "tool",
            "gate"
          ],
          "type": "string"
        }
      },
      "required": [
        "engine",
        "role"
      ],
      "title": "EngineLink",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "description": "One stated fact of a case. A case states each (concept, entity) pair at most once.",
      "properties": {
        "concept": {
          "description": "The fact's concept id.",
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "entity": {
          "default": "",
          "description": "The person or unit in the case; \"\" means the case as a whole.",
          "pattern": "^(?:\\S(?:[\\s\\S]*\\S)?)?$",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The fact's value: a number, true or false, text, or null."
        }
      },
      "required": [
        "concept",
        "value"
      ],
      "title": "Fact",
      "type": "object"
    },
    "LedgerCell": {
      "additionalProperties": false,
      "description": "One cell a ledger entry covers, with the difference the entry predicts there.",
      "properties": {
        "basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How the prediction was made."
        },
        "case_id": {
          "description": "The case id.",
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "case_set": {
          "description": "The case set.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+@=-]*$",
          "type": "string"
        },
        "entity": {
          "default": "",
          "description": "Which person or unit in the case; \"\" means the case's single unit.",
          "pattern": "^(?:\\S(?:[\\s\\S]*\\S)?)?$",
          "type": "string"
        },
        "policy_world": {
          "description": "The PolicyWorld id.",
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "predicted_size": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The predicted difference for this cell, in the quantity's unit."
        },
        "quantity": {
          "description": "The Quantity id.",
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        }
      },
      "required": [
        "case_set",
        "case_id",
        "policy_world",
        "quantity"
      ],
      "title": "LedgerCell",
      "type": "object"
    },
    "LedgerEntry": {
      "additionalProperties": false,
      "description": "One explained (or not yet explained) cause of differences between runs. Key: id.\n\nRules: `runs` names at least one run and repeats none; `who_errs` names only runs in\n`runs`, and naming anyone needs grounds (`law` or `issue`); cell keys are unique. An open\nentry has no closer. Only a person closes an entry: an AI author may open a ledger entry\nand may not close one.",
      "properties": {
        "author": {
          "description": "Who opened the entry.",
          "pattern": "\\S",
          "type": "string"
        },
        "author_kind": {
          "description": "What kind of author opened the entry.",
          "enum": [
            "person",
            "ai_model",
            "rules_model",
            "harness",
            "unknown"
          ],
          "type": "string"
        },
        "cells": {
          "default": [],
          "description": "The cells the cause covers; cell keys are unique.",
          "items": {
            "$ref": "#/$defs/LedgerCell"
          },
          "type": "array"
        },
        "closed_by": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Who closed the entry."
        },
        "closed_by_kind": {
          "anyOf": [
            {
              "enum": [
                "person",
                "ai_model",
                "rules_model",
                "harness",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What kind of author closed the entry; only a person may."
        },
        "id": {
          "description": "The entry's id.",
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "issue": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A link to an issue or a published erratum."
        },
        "kind": {
          "description": "The kind of cause.",
          "enum": [
            "model_error",
            "law_reading",
            "convention",
            "input_map",
            "scope",
            "policy_world",
            "rounding",
            "explained_other",
            "unexplained"
          ],
          "type": "string"
        },
        "law": {
          "default": [],
          "description": "Citations to law.",
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "type": "array"
        },
        "note": {
          "default": "",
          "description": "Anything else about the entry.",
          "type": "string"
        },
        "predicted_size_rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A rule that predicts the size of the difference, in words."
        },
        "runs": {
          "description": "The Run ids the entry bears on.",
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+@=-]*$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "source_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The source tool's own label, kept as written."
        },
        "status": {
          "default": "open",
          "description": "Open until a person closes the entry.",
          "enum": [
            "open",
            "closed"
          ],
          "type": "string"
        },
        "summary": {
          "description": "The cause, in words.",
          "pattern": "\\S",
          "type": "string"
        },
        "who_errs": {
          "default": [],
          "description": "Run ids judged to err; a subset of runs; empty when nobody is named.",
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+@=-]*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "kind",
        "summary",
        "runs",
        "author",
        "author_kind"
      ],
      "title": "LedgerEntry",
      "type": "object"
    },
    "Model": {
      "additionalProperties": false,
      "description": "A model that answers cases: a rules engine, an AI model, a calculator. Key: id.\n\n`engine` names the engine family that lineage reads; a run's release must be one of\n`releases`.",
      "properties": {
        "engine": {
          "description": "The engine family, used for lineage; often equal to the model id.",
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "id": {
          "description": "The model's id.",
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "kind": {
          "description": "What kind of model it is.",
          "enum": [
            "rules_model",
            "ai_model",
            "ai_model_with_tools",
            "official_calculator",
            "worked_example"
          ],
          "type": "string"
        },
        "maintainer": {
          "description": "Who maintains the model.",
          "pattern": "\\S",
          "type": "string"
        },
        "name": {
          "description": "The model's name.",
          "pattern": "\\S",
          "type": "string"
        },
        "note": {
          "default": "",
          "description": "Anything else about the model.",
          "type": "string"
        },
        "releases": {
          "default": [],
          "description": "Known releases; a run's release must be listed here.",
          "items": {
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "maintainer",
        "engine"
      ],
      "title": "Model",
      "type": "object"
    },
    "PolicyWorld": {
      "additionalProperties": false,
      "description": "The law a case is answered under: a jurisdiction read at a date, with stated conventions.",
      "properties": {
        "conventions": {
          "default": [],
          "description": "Conventions the world states (take-up, uprating).",
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "type": "array"
        },
        "description": {
          "default": "",
          "description": "What the world is, in words.",
          "type": "string"
        },
        "id": {
          "description": "The policy world's id.",
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "jurisdiction": {
          "description": "The jurisdiction as a free-text id (\"us\", \"us-wi\", \"de\"); \"\" when not stated.",
          "pattern": "^(?:\\S(?:[\\s\\S]*\\S)?)?$",
          "type": "string"
        },
        "law_as_of": {
          "anyOf": [
            {
              "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The date or year the law is read at; null when the source does not state it."
        }
      },
      "required": [
        "id",
        "jurisdiction"
      ],
      "title": "PolicyWorld",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "A quantity models answer, such as a tax or a benefit amount. Key: id.\n\nA quantity carries no tolerance: tolerance is a named profile applied on read.",
      "properties": {
        "aliases": {
          "default": [],
          "description": "Each tool's own name for the quantity.",
          "items": {
            "$ref": "#/$defs/Alias"
          },
          "type": "array"
        },
        "description": {
          "default": "",
          "description": "What the quantity is, in words.",
          "type": "string"
        },
        "entity": {
          "default": "",
          "description": "The entity type (\"tax_unit\", \"household\", \"person\"); \"\" when not stated.",
          "type": "string"
        },
        "id": {
          "description": "The quantity's id.",
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "period": {
          "default": "",
          "description": "The period (\"year\", \"month\"); \"\" when not stated.",
          "type": "string"
        },
        "unit": {
          "default": "",
          "description": "The unit (\"currency:USD\"); \"\" when the source does not state it.",
          "type": "string"
        },
        "value_type": {
          "default": "amount",
          "description": "The type of the quantity's answers.",
          "enum": [
            "amount",
            "boolean",
            "category"
          ],
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "Run": {
      "additionalProperties": false,
      "description": "One run of a model over cases. Key: id.\n\nA run never derives from itself, and its switch names are unique. A run carries no\ntolerance.",
      "properties": {
        "batch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The batch the run belongs to, when stated."
        },
        "convention_files": {
          "default": [],
          "description": "Convention files the run applied.",
          "items": {
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
            "type": "string"
          },
          "type": "array"
        },
        "derives_from": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+@=-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The Run id this run derives from, when it derives from one."
        },
        "engines": {
          "default": [],
          "description": "Engines behind the values beyond the model's own.",
          "items": {
            "$ref": "#/$defs/EngineLink"
          },
          "type": "array"
        },
        "id": {
          "description": "The run's id; it names a file.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+@=-]*$",
          "type": "string"
        },
        "model": {
          "description": "The Model id.",
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "note": {
          "default": "",
          "description": "Anything else about the run.",
          "type": "string"
        },
        "produced_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When the run was produced, as the source states."
        },
        "release": {
          "anyOf": [
            {
              "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The model release; null when the source records none."
        },
        "rows_complete": {
          "default": true,
          "description": "False when the source kept only some of the run's values (for example only disagreements).",
          "type": "boolean"
        },
        "sample": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The sample the run drew, when stated."
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The random seed, when the run used one."
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The file the run's rows came from."
        },
        "switches": {
          "default": [],
          "description": "The settings that make the run repeatable; names are unique.",
          "items": {
            "$ref": "#/$defs/Switch"
          },
          "type": "array"
        },
        "view": {
          "default": "",
          "description": "The named configuration both runs of a joint comparison carry; \"\" means the model's default.",
          "pattern": "^(?:\\S(?:[\\s\\S]*\\S)?)?$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "model"
      ],
      "title": "Run",
      "type": "object"
    },
    "ScopedNote": {
      "additionalProperties": false,
      "description": "A note on a binding that bears on some quantities, or on every quantity.",
      "properties": {
        "quantities": {
          "default": [],
          "description": "Quantity ids the note bears on; empty means every quantity.",
          "items": {
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
            "type": "string"
          },
          "type": "array"
        },
        "text": {
          "description": "The note.",
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "ScopedNote",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "The file a run's rows came from.",
      "properties": {
        "schema_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The file's own schema version."
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The file's sha256 as 64 lowercase hexadecimal digits."
        },
        "tool": {
          "description": "The tool that produced the file (\"axiom-oracles\", \"policybench-key-check\").",
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "uri": {
          "description": "Where the file lives (repo@commit:path or a URL); \"\" when unknown.",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "uri"
      ],
      "title": "Source",
      "type": "object"
    },
    "Switch": {
      "additionalProperties": false,
      "description": "One setting that makes a run repeatable.",
      "properties": {
        "name": {
          "description": "The setting's name.",
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "value": {
          "description": "The setting's value, as text.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "Switch",
      "type": "object"
    },
    "ToleranceProfile": {
      "additionalProperties": false,
      "description": "A named tolerance applied on read. Key: id. It holds at most one rule per quantity.",
      "properties": {
        "description": {
          "default": "",
          "description": "What the profile is for, in words.",
          "type": "string"
        },
        "id": {
          "description": "The profile's id.",
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "method": {
          "default": "isclose",
          "description": "How two amounts are compared under a rule.",
          "enum": [
            "isclose",
            "abs_or_ratio"
          ],
          "type": "string"
        },
        "rules": {
          "default": [],
          "description": "At most one rule per quantity string.",
          "items": {
            "$ref": "#/$defs/ToleranceRule"
          },
          "type": "array"
        }
      },
      "required": [
        "id"
      ],
      "title": "ToleranceProfile",
      "type": "object"
    },
    "ToleranceRule": {
      "additionalProperties": false,
      "description": "The absolute and relative tolerance a profile applies to one quantity, or to all (\"*\").",
      "properties": {
        "absolute": {
          "default": 0.0,
          "description": "Absolute tolerance, in the quantity's unit.",
          "minimum": 0.0,
          "type": "number"
        },
        "quantity": {
          "description": "A Quantity id, or \"*\" for every quantity.",
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "relative": {
          "default": 0.0,
          "description": "Relative tolerance, as a fraction.",
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "quantity"
      ],
      "title": "ToleranceRule",
      "type": "object"
    },
    "Value": {
      "additionalProperties": false,
      "description": "One run's answer for one cell. Key: (case_set, case_id, policy_world, quantity, entity, run).\n\nRules: the status is `answered` exactly when `value` is not None, and an answered value\nkeeps the source's `raw` text. A value carries no tolerance.",
      "properties": {
        "case_id": {
          "description": "The case id.",
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "case_set": {
          "description": "The case set.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+@=-]*$",
          "type": "string"
        },
        "entity": {
          "default": "",
          "description": "Which person or unit in the case; \"\" means the case's single unit.",
          "pattern": "^(?:\\S(?:[\\s\\S]*\\S)?)?$",
          "type": "string"
        },
        "policy_world": {
          "description": "The PolicyWorld id.",
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "producer": {
          "default": "model",
          "description": "\"model\", or \"harness:<formula>\" when harness code computed the value from model outputs.",
          "pattern": "^(?:model$|harness:[\\s\\S]*\\S)",
          "type": "string"
        },
        "quantity": {
          "description": "The Quantity id.",
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
          "type": "string"
        },
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The answer as the source holds it, as text."
        },
        "run": {
          "description": "The Run id.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+@=-]*$",
          "type": "string"
        },
        "source_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The source tool's own status word, kept as written."
        },
        "status": {
          "description": "What the run returned for the cell.",
          "enum": [
            "answered",
            "not_covered",
            "error",
            "refused",
            "unparsed"
          ],
          "type": "string"
        },
        "status_detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "More about the status, such as error text."
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The answer as parsed; null unless the status is answered."
        }
      },
      "required": [
        "case_set",
        "case_id",
        "policy_world",
        "quantity",
        "run",
        "status"
      ],
      "title": "Value",
      "type": "object"
    }
  },
  "$id": "https://github.com/PolicyEngine/crosscheck/schemas/table.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Every record of one comparison set, each section sorted by key.",
  "properties": {
    "bindings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Binding"
      },
      "type": "array"
    },
    "cases": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Case"
      },
      "type": "array"
    },
    "ledger": {
      "default": [],
      "items": {
        "$ref": "#/$defs/LedgerEntry"
      },
      "type": "array"
    },
    "models": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Model"
      },
      "type": "array"
    },
    "policy_worlds": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PolicyWorld"
      },
      "type": "array"
    },
    "quantities": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Quantity"
      },
      "type": "array"
    },
    "runs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Run"
      },
      "type": "array"
    },
    "tolerance_profiles": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ToleranceProfile"
      },
      "type": "array"
    },
    "values": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Value"
      },
      "type": "array"
    }
  },
  "title": "Table",
  "type": "object"
}
